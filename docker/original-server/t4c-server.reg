Windows Registry Editor Version 5.00

; Config T4C Server originale, NETTOYEE.
; Le .reg fourni etait corrompu par la traduction FR (remplacement de
; caracteres dans les noms de cles : "Th 4th Coming Srvr", "Authntication",
; "Ntwork", chemins "C:\T4c Srvr\"). Le serveur attend les noms EXACTS
; anglais ; on les restaure ici et on pointe les chemins sur le dossier
; reel du conteneur : Z:\root\server (Wine mappe /root/server -> Z:\root\server).
; En mode Wine, /root/server = Z:\root\server.

[HKEY_LOCAL_MACHINE\SOFTWARE\Vircom]
[HKEY_LOCAL_MACHINE\SOFTWARE\Vircom\The 4th Coming Server]
"License"="VT4C20020060001-242823-C0651943"
"SHUTDOWN"=dword:00000001
"RegUpdate"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Vircom\The 4th Coming Server\Authentication]
"AuthenticationMethod"=dword:00000001
"VOP_SEC_IP"=""
"VOP_NAS_IP"=""
"VOP_SEC_PORT"=dword:00000000
"VOP_SECRET"=""
"AUTH_REALM"=""
"ODBC_DB_PWD"=""
"ODBC_DSN"="T4C Server"
"ODBC_NAME_FLD"="Account"
"ODBC_PWD_FLD"="Password"
"ODBC_TABLE"="T4Cusers"
"ODBC_CREDITS_FLD"=""
"ODBC_WHERE"=""
"ODBC_DB_USER"=""
"WG_T4C_KEY"=""
"VOP_ACCT_IP"=""
"VOP_ACCT_PORT"=dword:00000000
"VOP_2ND_AUTH_IP"=""
"VOP_2ND_AUTH_PORT"=dword:00000000
"REMOTE_WG_T4C_KEY"=""
"ACCESS_RIGHT_DENIAL_MSG"="You do not have access rights to play The 4th Coming."
"ODBC_DEDUCT_CREDITS"=dword:00000000
"VOP_STRIP_REALM"=""
"ODBC_PRIVILEGE_FLD"="T4CKey"
"ODBC_PRIVILEGE_VALUE"="1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Vircom\The 4th Coming Server\Characters]
"StartupGold"="200+1d50"
"DB_USER"=""
"DB_PWD"=""
"ShoutDelay"=dword:000000a0
"StartupItem1"="Cloth pants"
"StartupItem2"="Cloth vest"
"StartupItem3"="Rusterd Dirk"
"StartupItem4"="Torch"
"StartupItem5"="Torch"
"TeleportLocation1"="Blackblood's Castle"
"TeleportLocation1X"=dword:00000172
"TeleportLocation1Y"=dword:000006ea
"TeleportLocation1W"=dword:00000000
"TeleportLocation2"="Bridge of Lighthaven"
"TeleportLocation2X"=dword:00000ae6
"TeleportLocation2Y"=dword:00000406
"TeleportLocation2W"=dword:00000000
"TeleportLocation3"="Brigand's camp"
